      "link": null,
      "locked": false,
      "text": "Elevator\n────────────────────────────────\n-id: int\n-currentFloor: AtomicInteger\n-state: ElevatorState\n-running: volatile boolean\n-upRequests: TreeSet<Integer>\n-downRequests: TreeSet<Integer>\n-observers: List<ElevatorObserver>\n────────────────────────────────\n+addObserver(observer)\n+setState(state)\n+move()\n+addRequest(request) «sync»\n+run()\n+stopElevator()\n+getId() int\n+getCurrentFloor() int\n+getDirection() Direction",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "box-elevator",
      "originalText": "Elevator\n────────────────────────────────\n-id: int\n-currentFloor: AtomicInteger\n-state: ElevatorState\n-running: volatile boolean\n-upRequests: TreeSet<Integer>\n-downRequests: TreeSet<Integer>\n-observers: List<ElevatorObserver>\n────────────────────────────────\n+addObserver(observer)\n+setState(state)\n+move()\n+addRequest(request) «sync»\n+run()\n+stopElevator()\n+getId() int\n+getCurrentFloor() int\n+getDirection() Direction",
      "autoResize": true,
      "lineHeight": 1.2
    },

