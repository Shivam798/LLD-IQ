      "text": "Logger\n────────────────────────────\n-name: String\n-parent: Logger\n-appenders: CopyOnWriteArrayList\n-level: LogLevel\n-additivity: boolean\n────────────────────────────\n+addAppender(LogAppender)\n+setLevel(LogLevel)\n+setAdditivity(boolean)\n+getEffectiveLevel() LogLevel\n+log(LogLevel, String)\n+debug(String)\n+info(String)\n+warn(String)\n+error(String)\n+fatal(String)\n-callAppenders(LogMessage)",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "model-log",
      "originalText": "Logger\n────────────────────────────\n-name: String\n-parent: Logger\n-appenders: CopyOnWriteArrayList\n-level: LogLevel\n-additivity: boolean\n────────────────────────────\n+addAppender(LogAppender)\n+setLevel(LogLevel)\n+setAdditivity(boolean)\n+getEffectiveLevel() LogLevel\n+log(LogLevel, String)\n+debug(String)\n+info(String)\n+warn(String)\n+error(String)\n+fatal(String)\n-callAppenders(LogMessage)",
      "autoResize": true,
      "lineHeight": 1.2
    },
