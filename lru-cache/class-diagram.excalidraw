      "width": 370,
      "height": 150,
      "text": "CacheEntry<V>   «immutable»\n──────────────────────────\n- value: V\n- expiresAt: Instant  «null = never»\n──────────────────────────\n+ value(): V\n+ expiresAt(): Instant\n+ isExpired(Instant now): boolean",
      "originalText": "CacheEntry<V>   «immutable»\n──────────────────────────\n- value: V\n- expiresAt: Instant  «null = never»\n──────────────────────────\n+ value(): V\n+ expiresAt(): Instant\n+ isExpired(Instant now): boolean",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
