    {
      "id": "ttl-note",
      "type": "text",
      "x": 960,
      "y": 215,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 100042,
      "version": 1,
      "versionNonce": 100043,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1717459200000,
      "link": null,
      "locked": false,
      "width": 400,
      "height": 90,
      "text": "Why TTL lives on the entry, not in the policy:\n  eviction answers \"we are FULL — who leaves?\"\n  TTL answers      \"is this entry still TRUE?\"\nSo every policy gets TTL for free.",
      "originalText": "Why TTL lives on the entry, not in the policy:\n  eviction answers \"we are FULL — who leaves?\"\n  TTL answers      \"is this entry still TRUE?\"\nSo every policy gets TTL for free.",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.2
    },
