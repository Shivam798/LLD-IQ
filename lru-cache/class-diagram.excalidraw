      "link": null,
      "locked": false,
      "text": "Cache<K, V>\n──────────────\n- capacity: int\n- data: HashMap<K, V>\n- policy: EvictionPolicy<K>\n──────────────\n+ get(K): Optional<V>   «sync»\n+ put(K, V)            «sync»\n+ remove(K): boolean   «sync»\n+ size(): int          «sync»",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Cache<K, V>\n──────────────\n- capacity: int\n- data: HashMap<K, V>\n- policy: EvictionPolicy<K>\n──────────────\n+ get(K): Optional<V>   «sync»\n+ put(K, V)            «sync»\n+ remove(K): boolean   «sync»\n+ size(): int          «sync»",
      "autoResize": true,
      "lineHeight": 1.2
