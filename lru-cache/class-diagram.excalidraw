    {
      "id": "lru-text",
      "type": "text",
      "x": -100,
      "y": 672,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 100070,
      "version": 1,
      "versionNonce": 100071,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1717459200000,
      "link": null,
      "locked": false,
      "width": 440,
      "height": 205,
      "text": "LRUEvictionPolicy<K>   implements EvictionPolicy<K>\n──────────────\n- nodeMap: HashMap<K, Node<K>>\n- head: Node<K>   «sentinel»\n- tail: Node<K>   «sentinel»\n──────────────\n+ keyAdded(K)               O(1)\n+ keyAccessed(K)            O(1)\n+ keyRemoved(K)             O(1)\n+ selectEvictionCandidate() O(1)\n\nNested: Node<K> { K key; Node prev; Node next; }",
      "originalText": "LRUEvictionPolicy<K>   implements EvictionPolicy<K>\n──────────────\n- nodeMap: HashMap<K, Node<K>>\n- head: Node<K>   «sentinel»\n- tail: Node<K>   «sentinel»\n──────────────\n+ keyAdded(K)               O(1)\n+ keyAccessed(K)            O(1)\n+ keyRemoved(K)             O(1)\n+ selectEvictionCandidate() O(1)\n\nNested: Node<K> { K key; Node prev; Node next; }",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.2
    },
