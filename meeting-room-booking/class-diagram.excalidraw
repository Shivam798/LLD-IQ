      "text": "BookingService  <<Singleton>>\n- volatile instance\n- Map<String,MeetingRoom> rooms\n- List<BookingObserver> observers\n- volatile RoomAllocationStrategy strategy\n+ book(org, attendees, slot, amenities)\n+ findAvailableRooms(slot, n, amenities)\n+ cancel(booking)",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "svc",
      "originalText": "BookingService  <<Singleton>>\n- volatile instance\n- Map<String,MeetingRoom> rooms\n- List<BookingObserver> observers\n- volatile RoomAllocationStrategy strategy\n+ book(org, attendees, slot, amenities)\n+ findAvailableRooms(slot, n, amenities)\n+ cancel(booking)",
      "autoResize": false,
      "lineHeight": 1.25,
      "baseline": 11
    },
