      "text": "RateLimiter\n──────────────\n- strategyFactory:\n     Supplier<RateLimitStrategy>\n- perClient:\n     ConcurrentHashMap<String, RateLimitStrategy>\n──────────────\n+ RateLimiter(Supplier<RateLimitStrategy>)\n+ allow(String clientId): boolean",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "RateLimiter\n──────────────\n- strategyFactory:\n     Supplier<RateLimitStrategy>\n- perClient:\n     ConcurrentHashMap<String, RateLimitStrategy>\n──────────────\n+ RateLimiter(Supplier<RateLimitStrategy>)\n+ allow(String clientId): boolean",
      "autoResize": true,
      "lineHeight": 1.2,
      "baseline": 169
    },
