      "text": "«interface»\nRateLimitStrategy\n──────────────\n+ allow(): boolean\n\n(one instance per client,\n self-reads the clock,\n implementations synchronize allow())",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "«interface»\nRateLimitStrategy\n──────────────\n+ allow(): boolean\n\n(one instance per client,\n self-reads the clock,\n implementations synchronize allow())",
      "autoResize": true,
