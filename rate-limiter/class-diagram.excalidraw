    {
      "id": "leaky-text",
      "type": "text",
      "x": 1570,
      "y": 652,
      "width": 266.6015625,
      "height": 265.2,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
