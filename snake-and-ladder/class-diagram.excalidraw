      "boundElements": null,
      "updated": 1717459200000,
      "link": null,
      "locked": false,
      "text": "△ triangle  : extends (Snake/Ladder → BoardEntity)\n◆ filled diamond: composition (Game owns Board/Dice)\n◇ open diamond  : aggregation (Game holds Players, Manager holds Games)\n- - dashed     : depends-on / uses\n── solid       : association\n\nColors:\n  yellow  = enum\n  blue    = abstract class\n  green   = model\n  pink    = builder\n  orange  = service / singleton / entry",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "△ triangle  : extends (Snake/Ladder → BoardEntity)\n◆ filled diamond: composition (Game owns Board/Dice)\n◇ open diamond  : aggregation (Game holds Players, Manager holds Games)\n- - dashed     : depends-on / uses\n── solid       : association\n\nColors:\n  yellow  = enum\n  blue    = abstract class\n  green   = model\n  pink    = builder\n  orange  = service / singleton / entry",
      "autoResize": true,
      "lineHeight": 1.2,
      "baseline": 9
    }
