   "link": null,
   "locked": false,
   "text": "TaskScheduler  (engine)\n\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n- queue: PriorityQueue<Task>\n- tasks: Map<String,Task>\n- workerPool: ExecutorService\n- lock + available: Condition\n+ start() schedule() cancel()\n+ shutdown()\n- runDispatcher() / dispatch()",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "sched",
   "originalText": "TaskScheduler  (engine)\n\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n- queue: PriorityQueue<Task>\n- tasks: Map<String,Task>\n- workerPool: ExecutorService\n- lock + available: Condition\n+ start() schedule() cancel()\n+ shutdown()\n- runDispatcher() / dispatch()",
   "autoResize": true,
   "lineHeight": 1.25,
   "baseline": 220
  },
